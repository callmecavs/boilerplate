{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "figma-desktop": {
        "disabled": false,
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp"
      },
      "next-devtools": {
        "command": ["npx", "-y", "next-devtools-mcp@latest"],
        "disabled": false,
        "type": "local"
      },
      "playwright": {
        "command": ["npx", "@playwright/mcp@latest", "--headless"],
        "disabled": false,
        "type": "local"
      }
    }
  },
  "permissions": [
    { "action": "edit", "effect": "ask", "resource": "*" },
    { "action": "shell", "effect": "ask", "resource": "*" },
    { "action": "shell", "effect": "allow", "resource": "command -v *" },
    { "action": "shell", "effect": "allow", "resource": "git diff *" },
    { "action": "shell", "effect": "allow", "resource": "git log *" },
    { "action": "shell", "effect": "allow", "resource": "git ls-files *" },
    { "action": "shell", "effect": "allow", "resource": "git show *" },
    { "action": "shell", "effect": "allow", "resource": "git status *" },
    { "action": "shell", "effect": "allow", "resource": "grep *" },
    { "action": "shell", "effect": "allow", "resource": "ls *" },
    { "action": "shell", "effect": "allow", "resource": "node --version" },
    { "action": "shell", "effect": "allow", "resource": "pnpm --version" },
    { "action": "shell", "effect": "allow", "resource": "pnpm list *" },
    { "action": "shell", "effect": "allow", "resource": "pnpm view *" },
    { "action": "shell", "effect": "allow", "resource": "pwd" }
  ]
}
